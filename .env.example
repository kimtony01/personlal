# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올리지 않습니다)

# 뉴스 수집 (https://newsapi.org)
NEWSAPI_KEY=

# AIS 선박 위치 수집 (https://aisstream.io) - 없으면 AIS 지표는 '데이터 없음'
AISSTREAM_API_KEY=

# 알림 메일 (SMTP). 예: Gmail 은 smtp.gmail.com / 587 / starttls + 앱 비밀번호
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 쉼표로 여러 명
ALERT_RECIPIENTS=

# SMTP 대신 Brevo(https://brevo.com) HTTP API 로 발송 (SMTP 포트가 막힌 Render 무료 등).
# 있으면 SMTP 보다 우선. 보내는 주소는 SMTP_FROM (Brevo 에서 인증한 발신 주소)
BREVO_API_KEY=

# 배포용 Postgres (예: Neon). 있으면 SQLite 대신 사용
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# 선택: DB 위치 / 스케줄러 끄기(0)
# RISK_DB_PATH=risk_monitor.db
# SCHEDULER_ENABLED=1
